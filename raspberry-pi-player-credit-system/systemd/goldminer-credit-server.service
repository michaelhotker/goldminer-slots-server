[Unit]
Description=Gold Miner Slots Player Credit Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/goldminer-credit-server
Environment=GOLD_MINER_DB=/home/pi/goldminer-credit-server/data/players.sqlite3
ExecStart=/home/pi/goldminer-credit-server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
